# Private key wallet sumber dana (yang berisi 100 CELO). 0x + 64 hex.
# JANGAN commit file .env asli. Hanya dipakai oleh distribute.js & balances.js.
FUNDING_PRIVATE_KEY=

# RPC Celo (opsional). Default https://forno.celo.org
RPC_URL=https://forno.celo.org

# CELO per wallet saat distribusi. Default 0.99 — 100 CELO tak cukup untuk
# 100 × 1.0 + gas, jadi sisakan ruang gas. Naikkan kalau funding > 100.
AMOUNT_PER_WALLET=0.99

# Nominal deposit per tx ke game.
DEPOSIT_AMOUNT=0.001

# Jumlah wallet.
WALLET_COUNT=100

# Tx paralel maksimum.
CONCURRENCY=8
