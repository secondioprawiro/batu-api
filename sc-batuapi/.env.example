# Deployer private key. The contract is adminless — the deployer has no special
# powers after deploy; its only role is seeding the pool. DO NOT commit real keys.
PRIVATE_KEY=0xabc...

# Immutable minimum bet, in API base units (1 API = 1e18). Default 1e18 = 1 API.
MIN_BET=1000000000000000000

# Optional: CELO (in wei) sent to the payable constructor to seed the reward pool.
# This seed is donated (non-withdrawable). 1 ether = 1e18.
POOL_SEED_CELO=0

# OPTIONAL — only for Celoscan verification. Leave empty to skip, or verify
# instead with Blockscout/Sourcify (no API key needed — see README).
CELOSCAN_API_KEY=
